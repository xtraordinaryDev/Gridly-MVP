# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used in emails and auth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: shows the one-click demo logins and lets scripts/seed-*.ts run.
# Set to "true" ONLY on local/staging. Leave unset (or "false") in production.
NEXT_PUBLIC_DEMO_MODE=false

# Shared secret for /api/cron/daily (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me

# Optional: transactional email via Resend. Without it, emails are logged to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GridLink <onboarding@resend.dev>
# Optional: internal ops address that receives new-RFP notifications
GRIDLINK_NOTIFY_EMAIL=

# Anthropic API key for AI features (RFP drafting, supplier suggestions, bid briefs)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Optional: U.S. EIA open-data key for the "fuel prices near your sites" dashboard card
# (free — https://www.eia.gov/opendata/register.php). Refreshed by /api/cron/daily.
EIA_API_KEY=

# Optional: Google Maps Platform server key (restrict to Geocoding API + Places API (New)).
# Geocodes buyer sites and pulls posted prices at nearby stations. Places "fuelOptions"
# is the Enterprise + Atmosphere SKU: 1,000 free calls/month, ~$0.04 each after.
GOOGLE_MAPS_API_KEY=
# Max station grid cells refreshed per daily cron run (default 30 ≈ the free tier).
FUEL_STATION_DAILY_CELL_LIMIT=30
